# Biuro Rachunkowe AS — routing przyjaznych URL na klasycznym Apache (ALTe).
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Jeśli DocumentRoot wskazuje na katalog aplikacji:
  # RewriteBase /

  # Blokada bezpośredniego HTTP do katalogów i plików wrażliwych
  RewriteRule ^(lib|data)(/|$) - [F,L]
  RewriteRule ^config(\.example)?\.php$ - [F,L]
  RewriteRule (^|/)\. - [F,L]

  # Statyczne pliki z public/ (css, js, img, fonts, robots, sitemap)
  RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
  RewriteRule ^(.*)$ public/$1 [L]

  # Favicon
  RewriteRule ^favicon\.ico$ public/img/ico.jpg [L]

  # Front controller
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Cross-Origin-Resource-Policy "same-origin"
  Header set X-Permitted-Cross-Domain-Policies "none"

  # Długi cache dla plików statycznych (wersjonowane ?v= w HTML).
  SetEnvIf Request_URI "\.(?i:css|js|mjs|woff2|webp|jpe?g|png|gif|svg|ico)$" STATIC_ASSET
  Header set Cache-Control "public, max-age=31536000, immutable" env=STATIC_ASSET
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Nie serwuj plików PHP z katalogu public (gdyby ktoś wrzucił).
<IfModule mod_rewrite.c>
  RewriteRule ^public/.*\.(php|phtml|phar)$ - [F,L]
</IfModule>
